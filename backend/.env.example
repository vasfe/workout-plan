# Copy this file to .env in the same folder (backend/.env) and fill in your key.
# This file is already covered by .gitignore (".env" pattern) — never commit
# a file named .env with a real key in it.

# Default provider (ai.provider: groq in application.yml).
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your-key-here

# Only needed if you switch ai.provider to gemini in application.yml.
# Note: Gemini's free tier excludes EU/EEA/UK/Switzerland — requires billing
# to work from the UK. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
