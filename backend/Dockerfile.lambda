# --- Build stage ---
FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /app
COPY pom.xml .
RUN mvn dependency:go-offline -B
COPY src ./src
RUN mvn package -DskipTests -B

# --- Lambda runtime stage ---
FROM public.ecr.aws/lambda/java:17

COPY --from=build /app/target/*-aws.jar ${LAMBDA_TASK_ROOT}/lib/app.jar

CMD ["com.vasco.workoutplan.StreamLambdaHandler::handleRequest"]